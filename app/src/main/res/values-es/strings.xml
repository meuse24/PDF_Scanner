    <string name="info_section_privacy">Privacidad</string>
    <string name="info_privacy_body">Esta app no contiene publicidad, no recopila datos y no tiene modelo de suscripción. No se solicitan permisos de cámara, contactos ni red. Todos los escaneos se almacenan exclusivamente en su dispositivo y nunca lo abandonan.</string>
    <!-- Privacy screen -->
    <string name="privacy_keyword_1">Local</string>
    <string name="privacy_keyword_2">Sin conexión</string>
    <string name="privacy_keyword_3">Seguro</string>
    <string name="privacy_keyword_4">Privado</string>
    <string name="privacy_point_1">Esta app no contiene publicidad y almacena todos los escaneos exclusivamente en tu dispositivo.</string>
    <string name="privacy_point_2">No se transmiten documentos ni contenidos a servidores externos.</string>
    <string name="privacy_point_3">La función de escaneo utiliza Google Play Services. Pueden transmitirse datos de diagnóstico técnicos (p. ej. para análisis de errores). Los contenidos de tus documentos escaneados no se envían.</string>
    <string name="privacy_point_4">La app no recopila datos personales y no requiere permisos de red propios.</string>
    <string name="privacy_footer">Actualizado: marzo de 2026</string>

