    <string name="privacy_keyword_3">सुरक्षित</string>
    <string name="privacy_keyword_4">निजी</string>
    <string name="privacy_point_1">इस ऐप में कोई विज्ञापन नहीं है और सभी स्कैन केवल आपके डिवाइस पर संग्रहीत किए जाते हैं।</string>
    <string name="privacy_point_2">कोई भी दस्तावेज़ या सामग्री बाहरी सर्वर पर नहीं भेजी जाती।</string>
    <string name="privacy_point_3">स्कैन और OCR फ़ंक्शन Google Play Services का उपयोग करते हैं। त्रुटि विश्लेषण के लिए तकनीकी डायग्नोस्टिक डेटा भेजा जा सकता है। चीनी, जापानी और हिंदी के भाषा मॉडल पहली बार उपयोग करने पर Play Services के माध्यम से डाउनलोड होते हैं — आपके दस्तावेज़ों की सामग्री कभी नहीं भेजी जाती।</string>
    <string name="privacy_point_4">ऐप स्वयं कोई व्यक्तिगत डेटा एकत्र नहीं करता और किसी नेटवर्क अनुमति की आवश्यकता नहीं है।</string>
