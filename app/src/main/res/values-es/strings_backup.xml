    <string name="backup_group_title">Copia de seguridad cifrada</string>
    <string name="backup_hint">Los archivos de copia de seguridad están protegidos con contraseña. La contraseña no se puede recuperar. Esto no cifra adicionalmente los datos locales de la aplicación.</string>
    <string name="backup_create_action">Crear copia de seguridad cifrada</string>
    <string name="backup_restore_action">Restaurar copia de seguridad</string>
    <string name="help_item_encrypted_backup">Usa Copia de seguridad cifrada en Ajustes para crear o restaurar un archivo .m24backup protegido con contraseña. La contraseña no se puede recuperar. Los documentos restaurados se guardan de nuevo en el archivo local normal de la app.</string>
    <string name="privacy_keyword_8">Copia cifrada</string>
    <string name="privacy_point_8">Las copias cifradas solo se crean cuando eliges un archivo de destino. La contraseña no se puede recuperar. La copia protege el archivo exportado; tras restaurar, documentos y metadatos vuelven al archivo local normal de la app.</string>

