<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for API < 31.
    Exclude scanned PDFs and the Room database so they never leave the device,
    consistent with the privacy claim in the app's help screen (#2).
-->
<full-backup-content>
    <exclude domain="file"     path="scans"/>
    <exclude domain="database" path="pdf_scanner_db"/>
</full-backup-content>
