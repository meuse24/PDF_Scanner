    <string name="help_item_encrypted_backup">Use Backup criptografado nas configurações para criar ou restaurar um arquivo .m24backup protegido por senha. A senha não pode ser recuperada. Os documentos restaurados voltam ao arquivo local normal do app.</string>
    <string name="privacy_keyword_8">Backup criptografado</string>
    <string name="privacy_point_8">Backups criptografados só são criados quando você escolhe um arquivo de destino. A senha não pode ser recuperada. O backup protege o arquivo exportado; após a restauração, documentos e metadados voltam ao arquivo local normal do app.</string>

