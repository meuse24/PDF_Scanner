<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+.
    Exclude scanned PDFs and the Room database from both cloud backup and
    device-to-device transfer so they never leave the device (#2).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file"     path="scans"/>
        <exclude domain="database" path="pdf_scanner_db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file"     path="scans"/>
        <exclude domain="database" path="pdf_scanner_db"/>
    </device-transfer>
</data-extraction-rules>
