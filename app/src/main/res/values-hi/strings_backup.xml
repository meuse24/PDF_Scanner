    <string name="backup_group_title">एन्क्रिप्टेड बैकअप</string>
    <string name="backup_hint">बैकअप फ़ाइलें पासवर्ड से सुरक्षित होती हैं। पासवर्ड पुनः प्राप्त नहीं किया जा सकता। इससे ऐप का स्थानीय डेटा अतिरिक्त रूप से एन्क्रिप्ट नहीं होता।</string>
    <string name="backup_create_action">एन्क्रिप्टेड बैकअप बनाएँ</string>
    <string name="backup_restore_action">बैकअप पुनर्स्थापित करें</string>
    <string name="help_item_encrypted_backup">सेटिंग्स में एन्क्रिप्टेड बैकअप का उपयोग करके पासवर्ड-सुरक्षित .m24backup फ़ाइल बनाएं या पुनर्स्थापित करें। पासवर्ड वापस नहीं पाया जा सकता। पुनर्स्थापित दस्तावेज़ फिर से ऐप के सामान्य स्थानीय संग्रह में रखे जाते हैं।</string>
    <string name="privacy_keyword_8">एन्क्रिप्टेड बैकअप</string>
    <string name="privacy_point_8">एन्क्रिप्टेड बैकअप तभी बनते हैं जब आप लक्ष्य फ़ाइल चुनते हैं। बैकअप पासवर्ड वापस नहीं पाया जा सकता। बैकअप निर्यात की गई फ़ाइल की रक्षा करता है; पुनर्स्थापना के बाद दस्तावेज़ और मेटाडेटा फिर से ऐप के सामान्य स्थानीय संग्रह में रखे जाते हैं।</string>

