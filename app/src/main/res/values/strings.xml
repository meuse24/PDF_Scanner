    <string name="info_section_privacy">Privacy</string>
    <string name="info_privacy_body">This app contains no advertising, collects no data, and has no subscription model. No permissions for camera, contacts, or network are requested. All scans are stored exclusively on your device and never leave it.</string>
    <!-- Privacy screen -->
    <string name="privacy_keyword_1">Local</string>
    <string name="privacy_keyword_2">Offline</string>
    <string name="privacy_keyword_3">Secure</string>
    <string name="privacy_keyword_4">Private</string>
    <string name="privacy_point_1">This app contains no advertising and stores all created scans exclusively on your device.</string>
    <string name="privacy_point_2">No documents or content are actively transmitted to external servers.</string>
    <string name="privacy_point_3">The scan and OCR functions use Google Play Services. Technical diagnostic data may be transmitted for error analysis. Language models for Chinese, Japanese, and Hindi are downloaded via Play Services on first use — the content of your scanned documents is never sent.</string>
    <string name="privacy_point_4">The app itself does not collect any personal data and does not require its own network permissions.</string>
    <string name="privacy_footer">Last updated: March 2026</string>

